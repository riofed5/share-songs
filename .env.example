# Template. Copy this to .env.local and fill that copy in. Leave this one blank.
# .env.local is ignored by git; this file is committed so the next person knows
# which settings exist. Never put a real key or password in here. See README.md.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The admin login for /admin
ADMIN_USER=admin
ADMIN_PASSWORD=

# Any long random string. Used to sign the admin login cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Your pub's Google review page, shown as a button after a guest sends a song.
# Leave blank to hide the button.
GOOGLE_REVIEW_URL=

# Telegram notification for every new song request. Leave either one blank to
# send no notifications.
# The token comes from @BotFather in Telegram (send it /newbot).
TELEGRAM_BOT_TOKEN=
# The number of the chat, group or channel the bot should post to. Groups and
# channels start with a minus sign; keep it. See README.md for how to find it.
TELEGRAM_CHAT_ID=

# Any long random string. Lets the scheduler, and nobody else, send the daily
# Telegram summary of song requests (05:00 every day, Vietnam time). Leave
# blank for no daily summary. Generate one the same way as SESSION_SECRET.
CRON_SECRET=

# How many hours back the admin list shows. Leave blank for 12.
ADMIN_WINDOW_HOURS=
